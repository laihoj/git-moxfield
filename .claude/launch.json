{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "app-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3001"],
      "env": {
        "DATABASE_PATH": "data/demo.db",
        "MOXFIELD_SERVER_FETCH": "off",
        "NEXT_DIST_DIR": ".next-demo"
      },
      "port": 3001
    },
    {
      "name": "mock-moxfield",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["mock-moxfield"],
      "port": 4010
    },
    {
      "name": "app-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:mock", "--port", "3002"],
      "env": {
        "NEXT_DIST_DIR": ".next-mock"
      },
      "port": 3002
    },
    {
      "name": "app-real",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3003"],
      "env": {
        "DATABASE_PATH": "data/real-test.db",
        "NEXT_DIST_DIR": ".next-real",
        "PUBLIC_APP_URL": "http://localhost:3003"
      },
      "port": 3003
    }
  ]
}
