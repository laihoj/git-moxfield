# git-moxfield configuration. Copy to .env.local and adjust. All values are optional.

# Local SQLite database file (created on first start, migrations applied automatically).
# Used unless TURSO_DATABASE_URL is set.
DATABASE_PATH=data/git-moxfield.db

# Remote libSQL database (Turso in production, see docs/adr/0008). When set, the app uses
# it instead of DATABASE_PATH. The app never migrates a remote database itself: run
# `pnpm db:migrate` against it first (the app refuses a database that is not up to date).
# A local libSQL server (`turso dev`) works too: TURSO_DATABASE_URL=http://127.0.0.1:8080
# TURSO_DATABASE_URL=libsql://<database>-<organization>.turso.io
# Secret: set it in the hosting provider's environment settings, never in a committed file.
# TURSO_AUTH_TOKEN=

# Moxfield's API is private. Server-side requests are blocked by Cloudflare unless they
# carry a User-Agent issued by Moxfield (ask support@moxfield.com for personal,
# non-commercial projects). Without it, use the browser bookmarklet (see /setup).
# NEVER put a Moxfield-issued User-Agent here: it is a secret, and only the production
# deployment may use it (its database keeps the one-call-per-second limit for every
# instance; another database would keep a second limit). Set MOXFIELD_USER_AGENT in the
# Netlify production environment only (README, "Turn on server fetching").

# auto = fetch server-side when you refresh or commit; off = browser capture only.
# Default: auto, except on Netlify, where it is off (Moxfield blocks requests from cloud
# servers without the User-Agent, so decks only arrive through the bookmarklet).
MOXFIELD_SERVER_FETCH=auto

# Spacing between any two requests to Moxfield, all instances together (ADR 0009).
# Default 2000; at least 1500 against Moxfield's API.
# MOXFIELD_MIN_REQUEST_INTERVAL_MS=2000

# Public URL of this app, used when generating bookmarklets (e.g. a LAN address
# like http://192.168.1.20:3000 for use from your phone). Defaults to the request origin.
# Its host name is also accepted by the host check below. The app listens on 127.0.0.1
# only: a LAN address needs `pnpm start:lan` (or `pnpm dev:lan`).
# PUBLIC_APP_URL=

# Host check (protects against DNS rebinding): requests are answered only when they are
# addressed to an IP address, localhost (or *.localhost), the host of PUBLIC_APP_URL, or
# a host name listed here; anything else gets "421 Unknown host". List other names you
# use to reach the app, e.g. an mDNS name or a reverse proxy's domain (ports ignored).
# ALLOWED_HOSTS=mybox.local,decks.example.com
