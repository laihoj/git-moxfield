{
  "name": "git-moxfield",
  "version": "0.1.0",
  "private": true,
  "description": "Git-like version control, semantic diffs and history for Moxfield decks.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:lan": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:remote": "vitest run -c vitest.remote.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "export:git": "tsx --conditions=react-server scripts/export-git.ts",
    "import:local": "tsx --conditions=react-server scripts/import-local.ts",
    "mock-moxfield": "tsx --conditions=react-server tests/mock-moxfield/server.ts",
    "moxfield": "tsx --conditions=react-server scripts/moxfield.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "users": "tsx --conditions=react-server scripts/users.ts",
    "test:e2e:install": "playwright install chromium",
    "dev:mock": "MOXFIELD_API_BASE_URL=http://localhost:4010 MOXFIELD_SITE_ORIGIN=http://localhost:4010 CAPTURE_ALLOWED_ORIGINS=http://localhost:4010 DATABASE_PATH=data/mock.db next dev --hostname 127.0.0.1"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.54.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.3",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
